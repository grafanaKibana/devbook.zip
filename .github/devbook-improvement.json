{
  "schema_version": 1,
  "repo": "grafanaKibana/devbook.zip",
  "base_branch": "main",
  "state_branch": "maintenance/devbook-improvement-state",
  "model": "claude-sonnet-5-5",
  "claude_code_version": "2.1.285",
  "model_timeout_seconds": 900,
  "max_model_turns": 20,
  "max_review_repairs_per_batch": 1,
  "max_source_bytes": 2000000,
  "unknown_reset_recheck_hours": 24,
  "max_run_minutes": 30,
  "max_pr_notes": 5,
  "max_pr_lines": 1200,
  "owner_allowlist": [
    {
      "id": 45916288,
      "login": "grafanaKibana"
    }
  ],
  "required_check_contexts": [
    "pr-title",
    "major-approval"
  ],
  "validator_commands": [
    [
      "dotnet",
      "run",
      "--no-cache",
      "--file",
      "DevBook.Tooling/Scripts/ValidateVault.cs",
      "--",
      "--all",
      "--repo-root",
      ".."
    ],
    [
      "dotnet",
      "test",
      "DevBook.Tooling.Tests/DevBook.Tooling.Tests.csproj",
      "--configuration",
      "Release"
    ],
    [
      "node",
      "--test",
      ".codex/hooks/tests/note-review-hooks.test.mjs"
    ],
    [
      "npm",
      "--prefix",
      "Web",
      "run",
      "test",
      "--",
      "custom/transformers/publishing.test.ts"
    ]
  ],
  "content_quality": {
    "rules_version": 1,
    "authoritative_paths": [
      "AGENTS.md",
      ".claude/agents/note-writer.md",
      ".claude/agents/note-reviewer.md",
      ".codex/skills/obsidian-markdown/SKILL.md",
      "Vault/Templates/Pages/Template - Concept Page.md",
      "Vault/Templates/Pages/Template - Index.md",
      "Vault/Templates/Blocks/Template - Callout.md"
    ]
  },
  "automatic_export": true,
  "max_model_calls_per_run": 20,
  "max_nearby_question_notes": 4
}
