{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "node ./quartz/bootstrap-cli.mjs",
    "build": "npm run steptrace:build && npm run steptrace:check && node -e \"require('node:fs').rmSync('.quartz/plugins', { recursive: true, force: true })\" && npm run quartz -- plugin install --from-config && npm run quartz -- plugin install --latest && node ./scripts/site-content.mjs build",
    "serve": "node ./scripts/site-content.mjs serve",
    "readme:image": "playwright install chromium && node ./scripts/generate-readme-image.mjs",
    "docs": "node ./quartz/bootstrap-cli.mjs build --serve -d docs",
    "check": "npm run complexity:test && npm run home:test && npm run steptrace:test && npm run steptrace:typecheck && npm run steptrace:check && tsc --noEmit --incremental false && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "node --import tsx --test",
    "home:test": "node --import tsx --test ./custom/components/home-dashboard.test.ts",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "steptrace:build": "node ./custom/steptrace/build.mjs",
    "steptrace:check": "node ./custom/steptrace/build.mjs --check",
    "steptrace:lifecycle": "node ./custom/steptrace/steptrace.browser.mjs",
    "steptrace:test": "node --test ./custom/steptrace/steptrace.test.mjs",
    "steptrace:typecheck": "tsc --noEmit -p ./custom/steptrace/tsconfig.json",
    "steptrace:visual": "node ./custom/steptrace/steptrace.browser.mjs",
    "steptrace:watch": "node ./custom/steptrace/watch.mjs",
    "complexity:test": "node --import tsx --test ./custom/complexity/complexity.test.ts"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@floating-ui/dom": "^1.8.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.1.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.2",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "is-absolute-url": "^4.0.1",
    "isomorphic-git": "^1.38.7",
    "js-yaml": "^4.1.0",
    "lightningcss": "^1.32.0",
    "micromorph": "^0.4.5",
    "minimatch": "^11.0.5",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.1",
    "pretty-time": "^1.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "semver": "^7.7.3",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.5",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "toml": "^5.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@quartz-community/explorer": "^1.0.4",
    "@quartz-community/types": "^1.3.1",
    "@quartz-community/utils": "^1.2.0",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/pretty-time": "^1.1.5",
    "@types/semver": "^7.7.1",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.25.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
