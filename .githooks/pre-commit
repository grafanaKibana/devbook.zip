#!/usr/bin/env bash
set -e

# Pre-commit hook for DevBook Obsidian repo
# Runs vault maintenance automations on staged files

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Obsidian Git plugin can run hooks with a minimal PATH.
# Add common Node binary locations so markdownlint-cli2 is discoverable.
for bin_dir in /opt/homebrew/bin /opt/homebrew/opt/node@22/bin /usr/local/bin /usr/local/share/dotnet /opt/homebrew/share/dotnet; do
    [[ -d "$bin_dir" ]] && PATH="$bin_dir:$PATH"
done

cd "$REPO_ROOT"
SDK_VERSION="$(cd "$REPO_ROOT/.scripts" && dotnet --version)"
if [[ "$SDK_VERSION" != 10.0.100 ]]; then
    echo "[pre-commit] .NET SDK 10.0.100 is required; run bash .scripts/setup.sh after installing it." >&2
    exit 1
fi

# Hold the export lock across maintenance and the awaited local publication.
if [[ "${DEVBOOK_QUARTZ_MAINTENANCE:-}" != 1 ]]; then
    cd "$REPO_ROOT/.scripts"
    exec dotnet run --no-cache --file DevBook.Tooling/Scripts/SyncQuartz.cs -- --repo-root "$REPO_ROOT" --hook "$REPO_ROOT/.githooks/pre-commit"
fi

# Collect staged Vault files, including deletions, without splitting path names.
STAGED_VAULT=()
STAGED_MD=()
while IFS= read -r -d '' file; do
    [[ "$file" == Vault/* ]] || continue
    [[ "$file" == Vault/.obsidian/* ]] && continue
    STAGED_VAULT+=("$file")
    [[ "$file" =~ \.(md|MD)$ ]] && STAGED_MD+=("$file")
done < <(git diff --cached --name-only -z --no-renames)

# If no staged Vault files, skip vault automations.
if [[ ${#STAGED_VAULT[@]} -eq 0 ]]; then
    exit 0
fi

# Refresh published releases under the export lock, after source/output guards.
# Respect an explicitly staged deletion rather than recreating the page.
CHANGELOG_FILE="Vault/Home/Changelog.md"
if [[ -z "$(git diff --cached --name-only --diff-filter=D -- "$CHANGELOG_FILE")" ]]; then
    echo "[pre-commit] Refreshing release changelog..."
    python3 .scripts/generate-changelog.py
    git add -- "$CHANGELOG_FILE"
    if [[ ${#STAGED_MD[@]} -eq 0 ]] && ! git diff --cached --quiet -- "$CHANGELOG_FILE"; then
        STAGED_MD+=("$CHANGELOG_FILE")
    fi
fi

# Run vault maintenance automations in order
echo "[pre-commit] Running vault automations..."

# Note-derived artifacts only need refreshes when Markdown changed.
if [[ ${#STAGED_MD[@]} -gt 0 ]]; then
    # 1. Fill missing folder status and derive priority/level from children.
    ROLLUP_CHANGED=$(cd "$REPO_ROOT/.scripts" && dotnet run --no-cache --file DevBook.Tooling/Scripts/SyncFolderRollupFrontmatter.cs -- --repo-root "$REPO_ROOT" --write --force --print-changed)
    if [[ -n "$ROLLUP_CHANGED" ]]; then
        while IFS= read -r file; do
            git add "$REPO_ROOT/$file"
        done <<< "$ROLLUP_CHANGED"
        echo "[pre-commit] ✓ Folder frontmatter synced ($(echo "$ROLLUP_CHANGED" | wc -l | tr -d ' ') notes)"
    fi

    # 2. Generate roadmap canvas from folder structure
    (cd "$REPO_ROOT/.scripts" && dotnet run --no-cache --file DevBook.Tooling/Scripts/GenerateRoadmap.cs -- --repo-root "$REPO_ROOT")
    ROADMAP_FILE="Vault/Home/Roadmap.canvas"
    if ! git diff --quiet -- "$REPO_ROOT/$ROADMAP_FILE" 2>/dev/null; then
        git add "$REPO_ROOT/$ROADMAP_FILE"
        echo "[pre-commit] ✓ Roadmap canvas regenerated"
    fi
fi

# 3. Validate staged vault structure, metadata, links, and generated artifacts
echo "[pre-commit] Validating staged vault changes..."
if ! (cd "$REPO_ROOT/.scripts" && dotnet run --no-cache --file DevBook.Tooling/Scripts/ValidateVault.cs -- --repo-root "$REPO_ROOT" --staged); then
    echo ""
    echo "[pre-commit] ✗ Vault validation failed. Fix the violations above, then re-stage."
    exit 1
fi

# Card sources must have deliberate Learn assignment before publication.
echo "[pre-commit] Checking Learn source assignments..."
node "$REPO_ROOT/.scripts/qard-learn-sync/check.cjs"

exit 0
