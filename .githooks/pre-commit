#!/usr/bin/env bash
set -e

# Pre-commit hook for DevBook Obsidian repo
# Runs vault maintenance automations on staged files

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Obsidian Git plugin can run hooks with a minimal PATH.
# Add common Node binary locations so markdownlint-cli2 is discoverable.
for bin_dir in /opt/homebrew/bin /opt/homebrew/opt/node@22/bin /usr/local/bin /usr/local/share/dotnet /opt/homebrew/share/dotnet; do
    [[ -d "$bin_dir" ]] && PATH="$bin_dir:$PATH"
done

cd "$REPO_ROOT"
SDK_VERSION="$(cd "$REPO_ROOT/.scripts" && dotnet --version)"
if [[ "$SDK_VERSION" != 10.0.100 ]]; then
    echo "[pre-commit] .NET SDK 10.0.100 is required; run bash .scripts/setup.sh after installing it." >&2
    exit 1
fi

# Hold the source lock across maintenance and date preparation.
if [[ "${DEVBOOK_QUARTZ_MAINTENANCE:-}" != 1 ]]; then
    cd "$REPO_ROOT/.scripts"
    exec dotnet run --no-cache --file DevBook.Tooling/Scripts/PrepareCommit.cs -- --repo-root "$REPO_ROOT" --hook "$REPO_ROOT/.githooks/pre-commit"
fi

# Collect staged Vault files, including deletions, without splitting path names.
STAGED_VAULT=()
STAGED_MD=()
while IFS= read -r -d '' file; do
    [[ "$file" == Vault/* ]] || continue
    [[ "$file" == Vault/.obsidian/* ]] && continue
    STAGED_VAULT+=("$file")
    [[ "$file" =~ \.(md|MD)$ ]] && STAGED_MD+=("$file")
done < <(git diff --cached --name-only -z --no-renames)

# Regenerate agent configs when their rulesync source is staged.
# The feedback store is read in place and has no generated copy.
RULESYNC_STAGED=0
while IFS= read -r -d '' file; do
    case "$file" in
        .rulesync/skill-feedback/*) ;;
        .rulesync/*|rulesync.jsonc) RULESYNC_STAGED=1 ;;
    esac
done < <(git diff --cached --name-only -z --no-renames)

if [[ $RULESYNC_STAGED -eq 1 ]]; then
    rulesync_dirty() {
        { git -c core.quotePath=false diff --name-only
          git -c core.quotePath=false ls-files --others --exclude-standard; } | sort -u
    }
    RULESYNC_BEFORE="$(rulesync_dirty)"
    echo "[pre-commit] Regenerating agent configs from .rulesync..."
    if ! npx --yes rulesync@latest generate; then
        echo "[pre-commit] rulesync generate failed; run it manually, then commit again." >&2
        exit 1
    fi
    RULESYNC_GENERATED=()
    while IFS= read -r file; do
        [[ -n "$file" ]] && RULESYNC_GENERATED+=("$file")
    done < <(comm -13 <(printf '%s\n' "$RULESYNC_BEFORE") <(rulesync_dirty))
    if [[ ${#RULESYNC_GENERATED[@]} -gt 0 ]]; then
        git --literal-pathspecs add -A -- "${RULESYNC_GENERATED[@]}"
        echo "[pre-commit] ✓ Agent configs regenerated (${#RULESYNC_GENERATED[@]} files)"
    fi
fi

# If no staged Vault files, skip vault automations.
if [[ ${#STAGED_VAULT[@]} -eq 0 ]]; then
    exit 0
fi

# Refresh published releases under the source lock, after source guards.
# Respect an explicitly staged deletion rather than recreating the page.
CHANGELOG_FILE="Vault/Home/Changelog.md"
if [[ -z "$(git diff --cached --name-only --diff-filter=D -- "$CHANGELOG_FILE")" ]]; then
    echo "[pre-commit] Refreshing release changelog..."
    python3 .scripts/generate-changelog.py
    git add -- "$CHANGELOG_FILE"
    if [[ ${#STAGED_MD[@]} -eq 0 ]] && ! git diff --cached --quiet -- "$CHANGELOG_FILE"; then
        STAGED_MD+=("$CHANGELOG_FILE")
    fi
fi

# Run vault maintenance automations in order
echo "[pre-commit] Running vault automations..."

# Note-derived artifacts only need refreshes when Markdown changed.
if [[ ${#STAGED_MD[@]} -gt 0 ]]; then
    # 1. Fill missing folder status and derive priority/level from children.
    ROLLUP_TEMP=$(mktemp -d "${TMPDIR:-/tmp}/devbook-rollup.XXXXXX")
    trap 'rm -rf -- "$ROLLUP_TEMP"' EXIT
    ROLLUP_CHANGED_FILE="$ROLLUP_TEMP/changed.paths"
    (cd "$REPO_ROOT/.scripts" && dotnet run --no-cache --file DevBook.Tooling/Scripts/SyncFolderRollupFrontmatter.cs -- --repo-root "$REPO_ROOT" --write --force --changed-files-file "$ROLLUP_CHANGED_FILE")
    python3 - "$ROLLUP_CHANGED_FILE" "$REPO_ROOT" <<'PYTHON'
import os
import pathlib
import sys

report = pathlib.Path(sys.argv[1])
if not report.is_file() or report.is_symlink():
    raise SystemExit("Missing regular folder-rollup path report")
data = report.read_bytes()
if data and not data.endswith(b"\0"):
    raise SystemExit("Incomplete folder-rollup path report")
for record in data.split(b"\0")[:-1]:
    name = record.decode("utf-8", errors="strict")
    parts = name.split("/")
    target = os.path.join(sys.argv[2], name)
    if (not name.startswith("Vault/Home/") or not name.endswith(".md")
            or "\\" in name or any(part in ("", ".", "..") for part in parts)
            or not os.path.isfile(target) or os.path.realpath(target) != os.path.abspath(target)):
        raise SystemExit("Invalid folder-rollup path report")
PYTHON
    ROLLUP_CHANGED=()
    while IFS= read -r -d '' file; do
        ROLLUP_CHANGED+=("$file")
    done < "$ROLLUP_CHANGED_FILE"
    if [[ ${#ROLLUP_CHANGED[@]} -gt 0 ]]; then
        git --literal-pathspecs add -- "${ROLLUP_CHANGED[@]}"
        echo "[pre-commit] ✓ Folder frontmatter synced (${#ROLLUP_CHANGED[@]} notes)"
    fi

    # 2. Generate roadmap canvas from folder structure
    (cd "$REPO_ROOT/.scripts" && dotnet run --no-cache --file DevBook.Tooling/Scripts/GenerateRoadmap.cs -- --repo-root "$REPO_ROOT")
    ROADMAP_FILE="Vault/Home/Roadmap.canvas"
    if ! git diff --quiet -- "$REPO_ROOT/$ROADMAP_FILE" 2>/dev/null; then
        git add "$REPO_ROOT/$ROADMAP_FILE"
        echo "[pre-commit] ✓ Roadmap canvas regenerated"
    fi
fi

exit 0
