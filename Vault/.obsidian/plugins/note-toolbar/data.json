            "viewMode": "all"
          },
          "scriptConfig": {
            "pluginFunction": "evaluate",
            "expression": "const file = app.workspace.getActiveFile();\nconst statuses = [\"New\", \"In Progress\", \"Established\"];\nif (!file?.path.startsWith(\"Home/\") || !Object.hasOwn(app.metadataCache.getFileCache(file)?.frontmatter ?? {}, \"status\")) return;\nconst status = await ntb.suggester(statuses, null, { title: \"Set status\", placeholder: \"Choose a status\", allowCustomInput: false });\nif (statuses.includes(status) && app.workspace.getActiveFile() === file) {\n  await ntb.setProperty(\"status\", status);\n}"
          }
        }
      ],
