{
  "attachPath": {
    "attachmentRoot": "Assets",
    "saveAttE": "inFolderBelow",
    "attachmentPath": "Images/${notepath}",
    "attachFormat": "${notename} — ${originalname}",
    "type": "GLOBAL",
    "extensionOverride": [
      {
        "extension": "^([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[gG][iI][fF]|[wW][eE][bB][pP]|[sS][vV][gG]|[aA][vV][iI][fF]|[bB][mM][pP]|[iI][cC][oO]|[hH][eE][iI][cC]|[tT][iI][fF][fF]?)$",
        "attachmentRoot": "Assets",
        "saveAttE": "inFolderBelow",
        "attachmentPath": "Images/${notepath}",
        "attachFormat": "${notename} — ${originalname}"
      },
      {
        "extension": "^([pP][dD][fF]|[dD][oO][cC][xX]?|[xX][lL][sS][xX]?|[pP][pP][tT][xX]?|[oO][dD][tT]|[oO][dD][sS]|[oO][dD][pP]|[tT][xX][tT]|[cC][sS][vV]|[rR][tT][fF]|[eE][pP][uU][bB])$",
        "attachmentRoot": "Assets",
        "saveAttE": "inFolderBelow",
        "attachmentPath": "Documents/${notepath}",
        "attachFormat": "${notename} — ${originalname}"
      },
      {
        "extension": "^([mM][pP]3|[wW][aA][vV]|[oO][gG][gG]|[mM]4[aA]|[fF][lL][aA][cC]|[aA][aA][cC]|[oO][pP][uU][sS])$",
        "attachmentRoot": "Assets",
        "saveAttE": "inFolderBelow",
        "attachmentPath": "Audio/${notepath}",
        "attachFormat": "${notename} — ${originalname}"
      },
      {
        "extension": "^([mM][pP]4|[wW][eE][bB][mM]|[mM][oO][vV]|[mM][kK][vV]|[aA][vV][iI]|[mM]4[vV])$",
        "attachmentRoot": "Assets",
        "saveAttE": "inFolderBelow",
        "attachmentPath": "Video/${notepath}",
        "attachFormat": "${notename} — ${originalname}"
      },
      {
        "extension": "^([zZ][iI][pP]|7[zZ]|[rR][aA][rR]|[tT][aA][rR]|[gG][zZ]|[bB][zZ]2|[xX][zZ])$",
        "attachmentRoot": "Assets",
        "saveAttE": "inFolderBelow",
        "attachmentPath": "Archives/${notepath}",
        "attachFormat": "${notename} — ${originalname}"
      },
      {
        "extension": ".*",
        "attachmentRoot": "Assets",
        "saveAttE": "inFolderBelow",
        "attachmentPath": "Files/${notepath}",
        "attachFormat": "${notename} — ${originalname}"
      }
    ]
  },
  "dateFormat": "YYYYMMDDHHmmssSSS",
  "excludeExtensionPattern": "",
  "autoRenameAttachment": false,
  "excludedPaths": "Assets",
  "excludePathsArray": [
    "Assets"
  ],
  "excludeSubpaths": true,
  "originalNameStorage": [],
  "overridePath": {},
  "disableNotification": false
}
